                PRESTIGE COLLEGE
            </span>

        </div>


        <nav class="main-nav">

            <div class="nav-links">

                <!-- ABOUT US -->

                <div class="dropdown">

                    <a href="/about" class="dropbtn">
                        ABOUT US
                        <span class="arrow">▼</span>
                    </a>

                    <div class="dropdown-content">

                        <a href="/about">
                            About Institute
                        </a>

                        <a href="/vision">
                            Vision and Mission
                        </a>

                        <a href="/chairman">
                            Chairman
                        </a>

                        <a href="/director">
                            Director
                        </a>

                        <a href="/faculty">
