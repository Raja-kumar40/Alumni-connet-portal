<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Director - Prestige College</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        .inner-page {
            max-width: 1100px;
            margin: 40px auto;
            padding: 40px 30px;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.08);
            line-height: 1.8;
            color: #333;
        }

        .inner-page h1 {
            font-size: 38px;
            color: #123f9c;
            margin-bottom: 10px;
            text-align: center;
        }

        .inner-page .subtitle {
            text-align: center;
            color: #666;
            font-size: 17px;
            margin-bottom: 40px;
            font-style: italic;
        }

        /* ================= FULL IMAGE - NO CROP ================= */

        .director-image-block {
            position: relative;
            width: 100%;
            margin: 35px 0 30px;
            border-radius: 16px;
            overflow: hidden;

            background: linear-gradient(135deg, #eef4ff, #dbeafe);

            box-shadow:
                0 0 25px rgba(37, 99, 235, 0.45),
                0 0 50px rgba(37, 99, 235, 0.25),
                0 15px 40px rgba(0, 0, 0, 0.25);

            transition: all 0.4s ease;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 15px;
        }

        .director-image-block:hover {
            box-shadow:
                0 0 35px rgba(37, 99, 235, 0.75),
                0 0 70px rgba(37, 99, 235, 0.4),
                0 20px 50px rgba(0, 0, 0, 0.3);

            transform: translateY(-5px);
        }

        .director-image-block img {
            width: 100%;
            height: auto;
            max-height: 600px;

            object-fit: contain;
            object-position: center;

            display: block;

            border-radius: 12px;

            transition: transform 0.6s ease;
        }

        .director-image-block:hover img {
            transform: scale(1.03);
        }

        /* ================= LIGHT SWEEP ================= */

        .director-image-block::before {
            content: "";

            position: absolute;

            top: -50%;
            left: -60%;

            width: 40%;
            height: 200%;

            background: linear-gradient(
                90deg,
                transparent,
                rgba(255, 255, 255, 0.55),
                transparent
            );

            transform: skewX(-25deg);

            z-index: 3;

            pointer-events: none;

            animation: lightSweep 4s infinite;
        }

        @keyframes lightSweep {
            0% {
                left: -60%;
            }

            100% {
                left: 130%;
            }
        }

        /* ================= IMAGE CAPTION ================= */

        .image-caption {
            position: absolute;

            bottom: 15px;
            left: 15px;
            right: 15px;

            padding: 14px 20px;

            background: linear-gradient(
                to top,
                rgba(0, 0, 0, 0.85),
                rgba(0, 0, 0, 0)
            );

            color: white;

            font-size: 18px;
            font-weight: 700;

            z-index: 4;

            text-align: left;

            letter-spacing: 0.5px;

            border-radius: 10px;
        }

        .image-caption span {
            display: block;

            font-size: 13px;
            font-weight: 400;

            color: #dbeafe;

            margin-top: 3px;

            letter-spacing: 0.3px;
        }

        /* ================= CONTENT ================= */

        .content-section {
            margin-bottom: 40px;
            padding-bottom: 30px;
            border-bottom: 1px solid #eee;
        }

        .content-section:last-of-type {
            border-bottom: none;
        }

        .content-section h2 {
            font-size: 26px;
            color: #123f9c;

            margin-bottom: 15px;

            border-left: 5px solid #2563eb;

            padding-left: 15px;

            line-height: 1.3;
        }

        .content-section p {
            font-size: 16px;
            color: #444;

            margin-bottom: 15px;

            text-align: justify;

            line-height: 1.85;
        }

        .content-section ul {
            margin-left: 25px;
            margin-top: 12px;
        }

        .content-section ul li {
            font-size: 16px;
            color: #444;

            margin-bottom: 10px;

            line-height: 1.7;
        }

        /* ================= HIGHLIGHT ================= */

        .highlight-box {
            background: #eef4ff;

            border-left: 5px solid #2563eb;

            padding: 20px 25px;

            border-radius: 8px;

            margin: 25px 0;
        }

        .highlight-box p {
            margin: 0;

            color: #123f9c;

            font-weight: 500;

            font-size: 16px;

            font-style: italic;
        }

        /* ================= SIGNATURE ================= */

        .signature-box {
            margin-top: 30px;

            padding-top: 20px;

            border-top: 2px solid #eee;

            text-align: right;
        }

        .signature-box strong {
            font-size: 20px;

            color: #123f9c;

            display: block;
        }

        .signature-box span {
            display: block;

            font-size: 14px;

            color: #666;

            margin-top: 3px;
        }

        /* ================= BACK BUTTON ================= */

        .back-btn {
            display: inline-block;

            margin-top: 30px;

            padding: 12px 25px;

            background: #2563eb;

            color: white;

            text-decoration: none;

            border-radius: 7px;

            font-size: 15px;

            transition: 0.3s;
        }

        .back-btn:hover {
            background: #1d4ed8;

            transform: translateY(-3px);

            box-shadow: 0 8px 20px rgba(37, 99, 235, 0.4);
        }

        /* ================= MOBILE ================= */

        @media (max-width: 768px) {

            .inner-page {
                margin: 20px 15px;
                padding: 25px 20px;
            }

            .inner-page h1 {
                font-size: 28px;
            }

            .content-section h2 {
                font-size: 21px;
            }

            .director-image-block img {
                max-height: 400px;
            }

            .image-caption {
                font-size: 15px;
                padding: 10px 14px;
            }
        }
    </style>
</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <header class="navbar">

        <div class="college-brand">

            <img
                src="/images/college.png.jpg"
                alt="College Logo"
