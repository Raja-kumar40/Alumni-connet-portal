<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Vision and Mission - Prestige College</title>

    <!-- MAIN CSS -->
    <link rel="stylesheet" href="/css/style.css">

    <style>
        .inner-page {
            max-width: 1100px;
            margin: 40px auto;
            padding: 40px 30px;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.08);
            line-height: 1.8;
            color: #333;
        }

        .inner-page h1 {
            font-size: 38px;
            color: #123f9c;
            margin-bottom: 10px;
            text-align: center;
        }

        .inner-page .subtitle {
            text-align: center;
            color: #666;
            font-size: 17px;
            margin-bottom: 40px;
            font-style: italic;
        }

        /* ================= IMAGE + CONTENT BLOCK ================= */

        .img-content-block {
            display: flex;
            align-items: center;
            gap: 35px;
            margin-bottom: 55px;
            padding-bottom: 40px;
            border-bottom: 1px solid #eee;
        }

        .img-content-block:last-of-type {
            border-bottom: none;
        }

        /* Reverse layout */

        .img-content-block.reverse {
            flex-direction: row-reverse;
        }

        /* ================= IMAGE SIDE ================= */

        .img-side {
            flex: 1;
            position: relative;
            border-radius: 16px;
            overflow: hidden;

            box-shadow:
                0 0 25px rgba(37, 99, 235, 0.45),
                0 0 50px rgba(37, 99, 235, 0.25),
                0 15px 40px rgba(0, 0, 0, 0.2);

            transition: all 0.4s ease;
        }

        .img-side:hover {
            box-shadow:
                0 0 35px rgba(37, 99, 235, 0.75),
                0 0 70px rgba(37, 99, 235, 0.4),
                0 20px 50px rgba(0, 0, 0, 0.3);

            transform: translateY(-5px);
        }

        .img-side img {
            width: 100%;
            height: 320px;

            object-fit: cover;

            display: block;

            transition: transform 0.6s ease;
        }

        .img-side:hover img {
            transform: scale(1.05);
        }

        /* ================= LIGHT SWEEP ================= */

        .img-side::before {
            content: "";

            position: absolute;

            top: -50%;
            left: -60%;

            width: 40%;
            height: 200%;

            background: linear-gradient(
                90deg,
                transparent,
                rgba(255, 255, 255, 0.55),
                transparent
            );

            transform: skewX(-25deg);

            z-index: 3;

            pointer-events: none;

            animation: lightSweep 4s infinite;
        }

        @keyframes lightSweep {

            0% {
                left: -60%;
            }

            100% {
                left: 130%;
            }

        }

        /* ================= CONTENT SIDE ================= */

        .content-side {
            flex: 1;
        }

        .content-side h2 {
            font-size: 24px;

            color: #123f9c;

            margin-bottom: 12px;

            border-left: 5px solid #2563eb;

            padding-left: 14px;

            line-height: 1.3;
        }

        .content-side p {
            font-size: 15px;

            color: #555;

            margin-bottom: 12px;

            text-align: justify;
        }

        .content-side ul {
            margin-left: 20px;
            margin-top: 10px;
        }

        .content-side ul li {
            font-size: 15px;

            color: #555;

            margin-bottom: 8px;
        }

        /* ================= HIGHLIGHT BOX ================= */

        .highlight-box {
            background: #eef4ff;

            border-left: 5px solid #2563eb;

            padding: 18px 22px;

            border-radius: 8px;

            margin: 25px 0;
        }

        .highlight-box p {
            margin: 0;

            color: #123f9c;

            font-weight: 500;

            font-size: 15px;
        }

        /* ================= BACK BUTTON ================= */

        .back-btn {
            display: inline-block;

            margin-top: 30px;

            padding: 12px 25px;

            background: #2563eb;

            color: white;

            text-decoration: none;

            border-radius: 7px;

            font-size: 15px;

            transition: 0.3s;
        }

        .back-btn:hover {
            background: #1d4ed8;

            transform: translateY(-3px);

            box-shadow: 0 8px 20px rgba(37, 99, 235, 0.4);
        }

        /* ================= RESPONSIVE ================= */

        @media (max-width: 850px) {

            .img-content-block,
            .img-content-block.reverse {
                flex-direction: column;
                gap: 25px;
            }

            .img-side img {
                height: 260px;
            }

            .content-side h2 {
                font-size: 21px;
            }

            .inner-page {
                margin: 20px 15px;
                padding: 25px 20px;
            }

            .inner-page h1 {
                font-size: 28px;
            }

        }
    </style>
