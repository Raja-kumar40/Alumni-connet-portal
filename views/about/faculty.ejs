    <!-- MAIN CSS -->
    <link rel="stylesheet" href="/css/style.css">

    <style>
        .inner-page {
            max-width: 1300px;
            margin: 40px auto;
            padding: 40px 25px;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.08);
            line-height: 1.8;
            color: #333;
        }

        .inner-page h1 {
            font-size: 38px;
            color: #123f9c;
            margin-bottom: 10px;
            text-align: center;
        }

        .inner-page .subtitle {
            text-align: center;
            color: #666;
            font-size: 17px;
            margin-bottom: 45px;
            font-style: italic;
        }

        /* ================= FACULTY GRID ================= */

        .faculty-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 28px 22px;
            margin-bottom: 45px;
        }

        .faculty-card {
            text-align: center;
            transition: all 0.4s ease;
        }

        .faculty-card:hover {
            transform: translateY(-8px);
        }

        /* ================= ROUND IMAGE ================= */

        .round-image-wrapper {
            position: relative;
            display: inline-block;

            width: 100%;
            max-width: 200px;

            aspect-ratio: 1 / 1;

            border-radius: 50%;

            overflow: hidden;

            box-shadow:
                0 0 18px rgba(37, 99, 235, 0.45),
                0 0 38px rgba(37, 99, 235, 0.25),
                0 8px 22px rgba(0, 0, 0, 0.2);

            transition: all 0.4s ease;

            border: 5px solid #ffffff;

            background: #f0f5ff;
        }

        .faculty-card:hover .round-image-wrapper {
            box-shadow:
                0 0 32px rgba(37, 99, 235, 0.85),
                0 0 65px rgba(37, 99, 235, 0.5),
                0 12px 30px rgba(0, 0, 0, 0.3);

            border-color: #dbeafe;
        }

        .round-image-wrapper img {
            width: 100%;
            height: 100%;

            object-fit: cover;
            object-position: center top;

            display: block;

            transition: transform 0.6s ease;
        }

        .faculty-card:hover .round-image-wrapper img {
            transform: scale(1.08);
        }

        /* ================= LIGHT SWEEP ================= */

        .round-image-wrapper::before {
            content: "";

            position: absolute;

            top: -50%;
            left: -60%;

            width: 40%;
            height: 200%;

            background: linear-gradient(
                90deg,
                transparent,
                rgba(255, 255, 255, 0.6),
                transparent
            );

            transform: skewX(-25deg);

            z-index: 3;

            pointer-events: none;

            animation: lightSweep 4s infinite;
        }

        @keyframes lightSweep {
            0% {
                left: -60%;
            }

            100% {
                left: 130%;
            }
        }

        .faculty-card:nth-child(4n+1)
        .round-image-wrapper::before {
            animation-delay: 0s;
        }

        .faculty-card:nth-child(4n+2)
        .round-image-wrapper::before {
            animation-delay: 0.4s;
        }

        .faculty-card:nth-child(4n+3)
        .round-image-wrapper::before {
            animation-delay: 0.8s;
        }

        .faculty-card:nth-child(4n+4)
        .round-image-wrapper::before {
            animation-delay: 1.2s;
        }

        /* ================= FACULTY NAME ================= */

        .faculty-name {
            font-size: 15px;
            color: #123f9c;
            font-weight: 700;

            margin-top: 15px;
            margin-bottom: 3px;

            line-height: 1.3;
        }

        .faculty-designation {
            font-size: 12px;
            color: #666;
            font-weight: 500;

            letter-spacing: 0.2px;
        }

        /* ================= RESPONSIVE ================= */

        @media (max-width: 1100px) {

            .faculty-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 25px 20px;
            }
        }

        @media (max-width: 800px) {

            .faculty-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 22px 18px;
            }

            .inner-page {
                margin: 20px 15px;
                padding: 25px 18px;
            }

            .inner-page h1 {
                font-size: 28px;
            }
        }

        @media (max-width: 500px) {

            .faculty-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 18px 12px;
            }

            .faculty-name {
                font-size: 13px;
            }

            .faculty-designation {
                font-size: 10px;
            }
        }

        /* ================= BACK BUTTON ================= */

        .back-btn {
            display: inline-block;

            margin-top: 30px;

            padding: 12px 25px;

            background: #2563eb;

            color: white;

            text-decoration: none;

            border-radius: 7px;

            font-size: 15px;

            transition: 0.3s;
        }

        .back-btn:hover {
            background: #1d4ed8;

            transform: translateY(-3px);

            box-shadow: 0 8px 20px rgba(37, 99, 235, 0.4);
        }
    </style>
