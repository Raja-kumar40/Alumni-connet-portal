<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Alumni - Prestige College</title>

    <!-- MAIN CSS -->
    <link rel="stylesheet" href="/css/style.css">

    <style>
        /* ================= MESSAGE PAGE CSS ================= */

        .msg-wrapper {
            max-width: 900px;
            margin: 40px auto;
            padding: 35px 30px;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.08);
        }

        .msg-wrapper h1 {
            font-size: 30px;
            color: #123f9c;
            text-align: center;
            margin-bottom: 8px;
        }

        .msg-wrapper .subtitle {
            text-align: center;
            color: #666;
            font-size: 14px;
            margin-bottom: 28px;
        }

        /* ================= TABS ================= */

        .msg-tabs {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 25px;
        }

        .msg-tabs button {
            padding: 9px 20px;
            border: 1px solid #2563eb;
            background: white;
            color: #2563eb;
            border-radius: 6px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
            transition: 0.3s;
        }

        .msg-tabs button.active,
        .msg-tabs button:hover {
            background: #2563eb;
            color: white;
        }

        /* ================= CONTACT LIST ================= */

        .contact-list {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 25px;
        }

        .contact-card {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            background: #f8faff;
            border: 1px solid #e0e7ff;
            border-radius: 10px;
            cursor: pointer;
            transition: 0.25s;
        }

        .contact-card:hover {
            background: #eef4ff;
            border-color: #2563eb;
            transform: translateY(-2px);
        }

        .contact-card.selected {
            background: #2563eb;
            color: white;
            border-color: #2563eb;
        }

        .contact-card.selected .contact-info p {
            color: #dbeafe;
        }

        .contact-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: #2563eb;
            color: white;

            display: flex;
            align-items: center;
            justify-content: center;

            font-weight: bold;
            font-size: 14px;

            flex-shrink: 0;
        }

        .contact-card.selected .contact-avatar {
            background: white;
            color: #2563eb;
        }

        .contact-info h3 {
            font-size: 13px;
            margin: 0 0 2px;
        }

        .contact-info p {
            font-size: 11px;
            color: #666;
            margin: 0;
        }

        /* ================= MESSAGE FORM ================= */

        .message-form {
            background: #f8faff;
            padding: 22px;
            border-radius: 10px;
            border: 1px solid #e0e7ff;
        }

        .message-form h2 {
            font-size: 17px;
            color: #123f9c;
            margin-bottom: 12px;
        }

        .message-form label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #333;
            margin-bottom: 5px;
            margin-top: 10px;
        }

        .message-form input,
        .message-form textarea {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #ddd;
            border-radius: 7px;
            outline: none;
            font-size: 13px;
            font-family: inherit;
            box-sizing: border-box;
        }

        .message-form input:focus,
        .message-form textarea:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        .message-form textarea {
            resize: vertical;
            min-height: 110px;
        }

        .message-form button {
            margin-top: 15px;
            padding: 11px 26px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 7px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
        }

        .message-form button:hover {
            background: #1d4ed8;
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(37, 99, 235, 0.4);
        }

        /* ================= SUCCESS MESSAGE ================= */

        .success-msg {
            display: none;
            margin-top: 12px;
            padding: 11px 14px;
            background: #d1fae5;
            color: #065f46;
            border-radius: 7px;
            font-size: 13px;
            font-weight: 500;
        }

        /* ================= RESPONSIVE ================= */

        @media (max-width: 600px) {

            .msg-wrapper {
                margin: 20px 12px;
                padding: 22px 18px;
            }

            .contact-list {
                grid-template-columns: 1fr;
            }

            .msg-tabs button {
                padding: 7px 12px;
                font-size: 11px;
            }
        }
    </style>
</head>


<body>

    <!-- =====================================================
         NAVBAR
    ====================================================== -->

    <header class="navbar">

        <!-- COLLEGE BRAND -->

        <div class="college-brand">

            <img
                src="/images/college.png.jpg"
