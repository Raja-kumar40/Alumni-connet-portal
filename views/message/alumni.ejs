            </span>

        </div>


        <!-- MAIN NAVIGATION -->

        <nav class="main-nav">

            <div class="nav-links">


                <!-- ================= ABOUT US ================= -->

                <div class="dropdown">

                    <a href="/about" class="dropbtn">
                        ABOUT US
                        <span class="arrow">▼</span>
                    </a>

                    <div class="dropdown-content">

                        <a href="/about">
                            About Institute
                        </a>

                        <a href="/vision">
                            Vision and Mission
                        </a>

                        <a href="/chairman">
                            Chairman
                        </a>

                        <a href="/director">
                            Director
                        </a>

                        <a href="/faculty">
                            Faculty
                        </a>

                    </div>

                </div>


                <!-- ================= MESSAGE ================= -->

                <div class="dropdown">

                    <a href="/message/alumni" class="dropbtn">
                        MESSAGE
                        <span class="arrow">▼</span>
                    </a>

                    <div class="dropdown-content">

                        <a href="/message/alumni">
                            Alumni
                        </a>

                        <a href="/message/student">
                            Student
                        </a>

                        <a href="/message/other">
                            Other
                        </a>

                    </div>

                </div>


                <!-- ================= ACADEMICS ================= -->

                <div class="dropdown">

                    <a href="/#academics" class="dropbtn">
                        ACADEMICS
                        <span class="arrow">▼</span>
                    </a>

                    <div class="dropdown-content">

                        <a href="/#academics">
                            Programs
                        </a>

                        <a href="/#academics">
                            Departments
                        </a>

                    </div>

                </div>


                <!-- ================= CONTACT ================= -->

                <div class="dropdown">

                    <a href="/#contact" class="dropbtn">
                        CONTACT US
                        <span class="arrow">▼</span>
                    </a>

                    <div class="dropdown-content">

                        <a href="/#contact">
                            Enquiry
                        </a>

                        <a href="/#contact">
                            Address
                        </a>

                    </div>

                </div>

            </div>


            <!-- SEARCH -->

            <div class="nav-search">

                <input
                    type="text"
                    id="navSearch"
                    placeholder="Search..."
                >

                <button onclick="searchWebsite()">
                    🔍
                </button>

            </div>

        </nav>


        <!-- LOGIN / REGISTER -->

        <div class="nav-buttons">

            <button onclick="openLogin()">
                Login
            </button>

            <button
                class="join-btn"
                onclick="openRegister()"
            >
                Join Network
            </button>

        </div>

    </header>



    <!-- =====================================================
         ALUMNI MESSAGE PAGE
    ====================================================== -->

    <section class="msg-wrapper">

        <h1>
            Message to Alumni
        </h1>

        <p class="subtitle">
            Connect with our successful alumni network
        </p>


        <!-- ================= ALUMNI LIST ================= -->

        <div class="contact-list" id="contactList">


            <!-- RAJA KUMAR -->

            <div
                class="contact-card"
                onclick="selectContact(
                    'Raja Kumar',
                    'Web Developer',
                    this
                )"
            >

                <div class="contact-avatar">
                    RK
                </div>

                <div class="contact-info">

                    <h3>
                        Raja Kumar
                    </h3>

                    <p>
                        Web Developer - ICT Info
                    </p>

                </div>

            </div>


            <!-- MANISH GUPTA -->

            <div
                class="contact-card"
                onclick="selectContact(
                    'Manish Gupta',
                    'Software Engineer',
                    this
                )"
            >

                <div class="contact-avatar">
                    MG
                </div>

                <div class="contact-info">

                    <h3>
                        Manish Gupta
                    </h3>

                    <p>
                        Software Engineer - Google
                    </p>

                </div>

            </div>


            <!-- ANAND KUMAR -->

            <div
                class="contact-card"
                onclick="selectContact(
                    'Anand Kumar',
                    'Data Analyst',
                    this
                )"
            >

                <div class="contact-avatar">
                    AK
                </div>

                <div class="contact-info">

                    <h3>
                        Anand Kumar
                    </h3>

                    <p>
                        Data Analyst - Microsoft
                    </p>

                </div>

            </div>


            <!-- MANISH RANJAN -->

            <div
                class="contact-card"
                onclick="selectContact(
                    'Manish Ranjan',
                    'Java Developer',
                    this
                )"
            >

                <div class="contact-avatar">
                    MR
                </div>

                <div class="contact-info">

                    <h3>
                        Manish Ranjan
                    </h3>

                    <p>
                        Java Developer - TCS
                    </p>

                </div>

            </div>


            <!-- PRIYA SINGH -->

            <div
                class="contact-card"
                onclick="selectContact(
                    'Priya Singh',
                    'HR Manager',
                    this
                )"
            >

                <div class="contact-avatar">
                    PS
                </div>

                <div class="contact-info">

                    <h3>
                        Priya Singh
                    </h3>

                    <p>
                        HR Manager - Infosys
                    </p>

                </div>

            </div>


            <!-- AYUSH SHARMA -->

            <div
                class="contact-card"
                onclick="selectContact(
                    'Ayush Sharma',
                    'Product Manager',
                    this
                )"
            >

                <div class="contact-avatar">
                    AS
                </div>

                <div class="contact-info">

                    <h3>
                        Ayush Sharma
                    </h3>

                    <p>
                        Product Manager - Amazon
                    </p>

                </div>

            </div>

        </div>



        <!-- =================================================
             MESSAGE FORM
        ================================================== -->

        <div class="message-form">

            <h2>
                Write Your Message
            </h2>


            <form
                id="msgForm"
                onsubmit="sendAlumniMessage(event)"
            >

                <!-- TO -->

                <label>
                    To:
                </label>

                <input
                    type="text"
                    id="toField"
                    placeholder="Select an alumni above"
                    readonly
                    required
                >


                <!-- SUBJECT -->

                <label>
                    Subject:
                </label>

                <input
                    type="text"
                    id="subjectField"
                    placeholder="Enter subject"
                    required
                >


                <!-- MESSAGE -->

                <label>
                    Message:
                </label>

                <textarea
                    id="messageField"
                    placeholder="Write your message here..."
                    required
                ></textarea>


                <!-- SEND -->

                <button type="submit">
                    Send Message
                </button>


                <!-- SUCCESS -->

                <div
                    class="success-msg"
                    id="successMsg"
                >
                    ✅ Your message has been sent successfully!
                </div>

            </form>

        </div>

    </section>



    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

    <script>

        let selectedName = "";


        /* ================= SELECT ALUMNI ================= */

        function selectContact(name, role, element) {

            selectedName = name;


            document
                .querySelectorAll(".contact-card")
                .forEach(function(card) {

                    card.classList.remove("selected");

                });


            element.classList.add("selected");


            document.getElementById("toField").value =
                name + " (" + role + ")";
        }



        /* ================= SEND MESSAGE ================= */

        function sendAlumniMessage(event) {

            event.preventDefault();


            if (!selectedName) {

                alert("Please select an alumni first!");

                return;
            }


            document.getElementById("successMsg").style.display =
                "block";


            document.getElementById("msgForm").reset();


            document
                .querySelectorAll(".contact-card")
                .forEach(function(card) {

                    card.classList.remove("selected");

                });


            selectedName = "";


            setTimeout(function() {

                document.getElementById("successMsg").style.display =
                    "none";

            }, 3000);

        }

    </script>


    <!-- MAIN SCRIPT -->

    <script src="/js/script-new.js"></script>

</body>

</html>