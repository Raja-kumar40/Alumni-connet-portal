<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Other - Prestige College</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        /* ================= MESSAGE PAGE CSS ================= */

        .msg-wrapper {
            max-width: 900px;
            margin: 40px auto;
            padding: 35px 30px;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.08);
        }

        .msg-wrapper h1 {
            font-size: 30px;
            color: #123f9c;
            text-align: center;
            margin-bottom: 8px;
        }

        .msg-wrapper .subtitle {
            text-align: center;
            color: #666;
            font-size: 14px;
            margin-bottom: 28px;
        }

        /* ================= CONTACT LIST ================= */

        .contact-list {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 25px;
        }

        .contact-card {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            background: #f8faff;
            border: 1px solid #e0e7ff;
            border-radius: 10px;
            cursor: pointer;
            transition: 0.25s;
        }

        .contact-card:hover {
            background: #eef4ff;
            border-color: #2563eb;
            transform: translateY(-2px);
        }

        .contact-card.selected {
            background: #2563eb;
            color: white;
            border-color: #2563eb;
        }

        .contact-card.selected .contact-info p {
            color: #dbeafe;
        }

        .contact-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: #2563eb;
            color: white;

            display: flex;
            align-items: center;
            justify-content: center;

            font-weight: bold;
            font-size: 14px;

            flex-shrink: 0;
        }

        .contact-card.selected .contact-avatar {
            background: white;
            color: #2563eb;
        }

        .contact-info h3 {
            font-size: 13px;
            margin: 0 0 2px;
        }

        .contact-info p {
            font-size: 11px;
            color: #666;
            margin: 0;
        }

        /* ================= MESSAGE FORM ================= */

        .message-form {
            background: #f8faff;
            padding: 22px;
            border-radius: 10px;
            border: 1px solid #e0e7ff;
        }

        .message-form h2 {
            font-size: 17px;
            color: #123f9c;
            margin-bottom: 12px;
        }

        .message-form label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #333;
            margin-bottom: 5px;
            margin-top: 10px;
        }

        .message-form input,
        .message-form textarea {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #ddd;
            border-radius: 7px;
            outline: none;
            font-size: 13px;
            font-family: inherit;
            box-sizing: border-box;
        }

        .message-form input:focus,
        .message-form textarea:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        .message-form textarea {
            resize: vertical;
            min-height: 110px;
        }

        .message-form button {
            margin-top: 15px;
            padding: 11px 26px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 7px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
        }

        .message-form button:hover {
            background: #1d4ed8;
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(37, 99, 235, 0.4);
        }

        /* ================= SUCCESS MESSAGE ================= */

        .success-msg {
            display: none;
            margin-top: 12px;
            padding: 11px 14px;
            background: #d1fae5;
            color: #065f46;
            border-radius: 7px;
            font-size: 13px;
            font-weight: 500;
        }

        /* ================= RESPONSIVE ================= */

        @media (max-width: 600px) {

            .msg-wrapper {
                margin: 20px 12px;
                padding: 22px 18px;
            }

            .contact-list {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>


<body>

    <!-- ================= NAVBAR ================= -->

    <header class="navbar">

        <div class="college-brand">

            <img
                src="/images/college.png.jpg"
                alt="College Logo"
                class="college-image"
            >

            <span class="college-name">
                PRESTIGE COLLEGE
            </span>

        </div>


        <nav class="main-nav">

            <div class="nav-links">

                <!-- ABOUT US -->

                <div class="dropdown">

                    <a href="/about" class="dropbtn">
                        ABOUT US
                        <span class="arrow">▼</span>
                    </a>

                    <div class="dropdown-content">

                        <a href="/about">
                            About Institute
                        </a>

                        <a href="/vision">
                            Vision and Mission
                        </a>

                        <a href="/chairman">
                            Chairman
                        </a>

                        <a href="/director">
                            Director
                        </a>

                        <a href="/faculty">
                            Faculty
                        </a>

                    </div>

                </div>


                <!-- MESSAGE -->

                <div class="dropdown">

                    <a href="/message/other" class="dropbtn">
                        MESSAGE
                        <span class="arrow">▼</span>
                    </a>

                    <div class="dropdown-content">

                        <a href="/message/alumni">
                            Alumni
                        </a>

                        <a href="/message/student">
                            Student
                        </a>

                        <a href="/message/other">
                            Other
                        </a>

                    </div>

                </div>


                <!-- ACADEMICS -->

                <div class="dropdown">

                    <a href="/#academics" class="dropbtn">
                        ACADEMICS
                        <span class="arrow">▼</span>
                    </a>

                    <div class="dropdown-content">

                        <a href="/#academics">
                            Programs
                        </a>

                        <a href="/#academics">
                            Departments
                        </a>

                    </div>

                </div>


                <!-- CONTACT US -->

                <div class="dropdown">

                    <a href="/#contact" class="dropbtn">
                        CONTACT US
                        <span class="arrow">▼</span>
                    </a>

                    <div class="dropdown-content">

                        <a href="/#contact">
                            Enquiry
                        </a>

                        <a href="/#contact">
                            Address
                        </a>

                    </div>

                </div>

            </div>


            <!-- SEARCH -->

            <div class="nav-search">

                <input
                    type="text"
                    id="navSearch"
                    placeholder="Search..."
                >

                <button onclick="searchWebsite()">
                    🔍
                </button>

            </div>

        </nav>


        <!-- LOGIN / REGISTER -->

        <div class="nav-buttons">

            <button onclick="openLogin()">
                Login
            </button>

            <button
                class="join-btn"
                onclick="openRegister()"
            >
                Join Network
            </button>

        </div>

    </header>


    <!-- ================= OTHER MESSAGE PAGE ================= -->

    <section class="msg-wrapper">

        <h1>
            Other Enquiries
        </h1>

        <p class="subtitle">
            Contact other departments and services of Prestige College
        </p>


        <!-- ================= DEPARTMENTS ================= -->

        <div class="contact-list" id="contactList">


            <!-- ADMISSION OFFICE -->

            <div
                class="contact-card"
                onclick="selectContact(
                    'Admission Office',
                    'Admission Related Enquiry',
                    this
                )"
            >

                <div class="contact-avatar">
                    AO
                </div>

                <div class="contact-info">

                    <h3>
                        Admission Office
                    </h3>

                    <p>
                        Admission Related Enquiry
                    </p>

                </div>

            </div>


            <!-- ACCOUNTS DEPARTMENT -->

            <div
                class="contact-card"
                onclick="selectContact(
                    'Accounts Department',
                    'Fee & Payment Related',
                    this
                )"
            >

                <div class="contact-avatar">
                    AC
                </div>

                <div class="contact-info">

                    <h3>
                        Accounts Department
                    </h3>

                    <p>
                        Fee & Payment Related
                    </p>

                </div>

            </div>


            <!-- EXAMINATION CELL -->

            <div
                class="contact-card"
                onclick="selectContact(
                    'Examination Cell',
                    'Exam & Result Related',
                    this
                )"
            >

                <div class="contact-avatar">
                    EC
                </div>

                <div class="contact-info">

                    <h3>
                        Examination Cell
                    </h3>

                    <p>
                        Exam & Result Related
                    </p>

                </div>

            </div>


            <!-- PLACEMENT CELL -->

            <div
                class="contact-card"
                onclick="selectContact(
                    'Placement Cell',
                    'Job & Internship Related',
                    this
                )"
            >

                <div class="contact-avatar">
                    PC
                </div>

                <div class="contact-info">

                    <h3>
                        Placement Cell
                    </h3>

                    <p>
                        Job & Internship Related
                    </p>

                </div>

            </div>


            <!-- LIBRARY -->

            <div
                class="contact-card"
                onclick="selectContact(
                    'Library',
                    'Books & Study Material',
                    this
                )"
            >

                <div class="contact-avatar">
                    LB
                </div>

                <div class="contact-info">

                    <h3>
                        Library
                    </h3>

                    <p>
                        Books & Study Material
                    </p>

                </div>

            </div>


            <!-- GENERAL ENQUIRY -->

            <div
                class="contact-card"
                onclick="selectContact(
                    'General Enquiry',
                    'Any Other Query',
                    this
                )"
            >

                <div class="contact-avatar">
                    GE
                </div>

                <div class="contact-info">

                    <h3>
                        General Enquiry
                    </h3>

                    <p>
                        Any Other Query
                    </p>

                </div>

            </div>

        </div>


        <!-- ================= MESSAGE FORM ================= -->

        <div class="message-form">

            <h2>
                Write Your Message
            </h2>


            <form
                id="msgForm"
                onsubmit="sendOtherMessage(event)"
            >

                <label>
                    To:
                </label>

                <input
                    type="text"
                    id="toField"
                    placeholder="Select a department above"
                    readonly
                    required
                >


                <label>
                    Subject:
                </label>

                <input
                    type="text"
                    id="subjectField"
                    placeholder="Enter subject"
                    required
                >


                <label>
                    Message:
                </label>

                <textarea
                    id="messageField"
                    placeholder="Write your message here..."
                    required
                ></textarea>


                <button type="submit">
                    Send Message
                </button>


                <div
                    class="success-msg"
                    id="successMsg"
                >
                    ✅ Your message has been sent successfully!
                </div>

            </form>

        </div>

    </section>


    <!-- ================= JAVASCRIPT ================= -->

    <script>

        let selectedName = "";


        /* SELECT DEPARTMENT */

        function selectContact(name, role, element) {

            selectedName = name;


            document
                .querySelectorAll(".contact-card")
                .forEach(function(card) {

                    card.classList.remove("selected");

                });


            element.classList.add("selected");


            document.getElementById("toField").value =
                name + " (" + role + ")";
        }


        /* SEND MESSAGE */

        function sendOtherMessage(event) {

            event.preventDefault();


            if (!selectedName) {

                alert("Please select a department first!");

                return;
            }


            document.getElementById("successMsg").style.display =
                "block";


            document.getElementById("msgForm").reset();


            document
                .querySelectorAll(".contact-card")
                .forEach(function(card) {

                    card.classList.remove("selected");

                });


            selectedName = "";


            setTimeout(function() {

                document.getElementById("successMsg").style.display =
                    "none";

            }, 3000);

        }

    </script>


    <!-- MAIN SCRIPT -->

    <script src="/js/script-new.js"></script>

</body>

</html>